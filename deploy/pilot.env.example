# No passwords/tokens. Copy outside Git; use one set of paths/hostname per organization.
PUBLIC_ORIGIN=https://pilot.example.com
SITE_HOST=pilot.example.com
TLS_EMAIL=administrator@example.com
PILOT_DATA_ROOT=/private/org-a-mount
PILOT_TLS_ROOT=/private/org-a-tls
HTTPS_PORT=8443
# Compose binds127.0.0.1 only. Public ingress/DNS/certificate acceptance is a separate manual step.
